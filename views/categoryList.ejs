<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/htmlhead.ejs") %>
  <body>
    <main class="page-shell">
      <%- include("./partials/header.ejs") %>
      <section class="page-section">
        <div class="section-heading">
          <p class="section-kicker">Organization</p>
          <h2>Category List</h2>
        </div>
        <% if(list.length === 0) { %>
          <div class="empty-state">
            <h3>Category list is empty</h3>
            <p>Create a category to group your products more clearly.</p>
          </div>
        <% } else{ %>
          <div class="card-grid">
            <% list.forEach((item) =>{ %>
              <article class="info-card">
                <div class="info-head">
                  <h3><%= item.categoryname %></h3>
                  <div class="product-actions">
                    <button
                      class="icon-action delete-action"
                      type="button"
                      aria-label="Delete category"
                      title="Delete category"
                      data-dialog-id="delete-<%= item.id %>"
                    >
                      <span class="action-icon" aria-hidden="true">✕</span>
                    </button>
                    <dialog class="confirm-dialog" id="delete-<%= item.id %>">
                      <div class="confirm-shell">
                        <div class="dialog-header">
                          <div>
                            <p class="section-kicker danger-kicker">Delete Category</p>
                            <h3>Remove <%= item.categoryname %>?</h3>
                          </div>
                          <button class="close-button" type="button" aria-label="Close dialog">&times;</button>
                        </div>
                        <p class="confirm-copy">
                          This will permanently remove the category from your inventory organization.
                        </p>
                        <div class="dialog-actions">
                          <button class="ghost-button close-button" type="button">Cancel</button>
                          <form action="/deletecategory/<%= item.id %>" method="post">
                            <button class="danger-button" type="submit">Delete Category</button>
                          </form>
                        </div>
                      </div>
                    </dialog>
                    <button
                      class="icon-action edit-button"
                      type="button"
                      aria-label="Edit category"
                      title="Edit category"
                      data-dialog-id="user-<%= item.id %>"
                    >
                      <span class="action-icon" aria-hidden="true">✎</span>
                    </button>
                    <dialog class="edit-form" id="user-<%= item.id %>">
                    <form class="styled-form modal-form" action="/editcategory/<%= item.id %>" method="post">
                     <div class="dialog-header">
                        <div>
                          <p class="section-kicker">Update Category</p>
                          <h3>Edit <%= item.categoryname %></h3>
                        </div>
                        <button class="close-button" type="button" aria-label="Close dialog">&times;</button>
                      </div>
                       <label for="name-<%= item.id %>">Category Name</label>
                        <input
                          type="text"
                          id="name-<%= item.id %>"
                          name="categoryName"
                          value="<%= item.categoryname %>"
                          required
                        />
                        <div class="dialog-actions">
                          <button class="ghost-button close-button" type="button">Cancel</button>
                          <button type="submit">Save Changes</button>
                        </div>
                    </form>
                </dialog>
                  </div>
                </div>
                <p><span>Type</span><strong>Product Category</strong></p>
                
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    </main>
  </body>
  <script>

  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('error') === 'in_use') {
    alert("Category in use, cannot delete");
    const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
    window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
  }

    const editButton = document.querySelectorAll(".edit-button");
    const closeButton = document.querySelectorAll(".close-button");
    const deleteButton = document.querySelectorAll(".delete-action");

    editButton.forEach((button) => {
      button.addEventListener("click", (event) => {
        const dialogId = event.currentTarget.dataset.dialogId;
        const editForm = document.getElementById(dialogId);

        if (editForm) {
          editForm.showModal();
        }
      });
    });

    closeButton.forEach((button) => {
      button.addEventListener("click", (event) => {
        const editForm = event.currentTarget.closest("dialog");

        if (editForm) {
          editForm.close();
        }
      });
    });

    document.querySelectorAll("dialog").forEach((dialog) => {
      dialog.addEventListener("click", (event) => {
        const bounds = dialog.getBoundingClientRect();
        const clickedBackdrop =
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom;

        if (clickedBackdrop) {
          dialog.close();
        }
      });
    });

    deleteButton.forEach((button) =>{
      button.addEventListener("click", (event)=>{
        const dialogId = event.currentTarget.dataset.dialogId;
        const deleteCategory = document.getElementById(dialogId);

        if(deleteCategory){
          deleteCategory.showModal();
        }
      })
    })
  </script>
</html>
